{
  "name": "dsh-route-keeper",
  "description": "Sticky model-route keeper for DeepSeek Harness: root/child sticky primary, bounded plugin-owned retry, cross-route fallback with same-activation auto-continue, host allowlist/role/egress enforcement, and optional bounded TypeSafe (Jev) advisory classification.",
  "version": "0.1.0",
  "license": "MIT",
  "author": "yario-ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yario-ai/dsh-route-keeper.git"
  },
  "homepage": "https://github.com/yario-ai/dsh-route-keeper#readme",
  "bugs": {
    "url": "https://github.com/yario-ai/dsh-route-keeper/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "README.md",
    "LICENSE",
    "NOTICE",
    "cordis.patch.yml",
    "package.json"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
